{
  "name": "network-flow-card",
  "version": "3.1.4",
  "type": "module",
  "scripts": {
    "build": "npm run build:card && npm run build:editor",
    "build:card": "rollup network-flow-card.js --file network-flow-card.js --format es --plugin @rollup/plugin-node-resolve --plugin @rollup/plugin-terser",
    "build:editor": "rollup network-flow-card-editor.js --file network-flow-card-editor.js --format es --plugin @rollup/plugin-node-resolve --plugin @rollup/plugin-terser"
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.0.0"
  }
}
